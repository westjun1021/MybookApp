<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- 배경색: 순백색(pure_white) -->
    <solid android:color="@color/pure_white"/>

    <!-- 모서리 둥글기 -->
    <corners android:radius="8dp"/>

    <!-- 테두리 두께(1dp) 및 색(진회색) -->
    <stroke
        android:width="1dp"
        android:color="@color/text_dark_gray"/>

    <!-- 내부 여백 -->
    <padding
        android:left="8dp"
        android:top="8dp"
        android:right="8dp"
        android:bottom="8dp"/>
</shape>
