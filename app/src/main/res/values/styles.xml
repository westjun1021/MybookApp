<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 1) MaterialComponents Light(NoActionBar) 기반 테마 정의 -->
    <style name="Theme.MyBookshelf" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- 툴바·상태바의 기본 색상을 책장 테마 색으로 지정 -->
        <item name="colorPrimary">@color/bookshelf_yellow</item>
        <item name="colorPrimaryVariant">@color/bookshelf_yellow_dark</item>

        <!-- CardView 커스텀 스타일 (라이트 모드) -->
        <item name="materialCardViewStyle">@style/MyCardViewLight</item>

        <!-- 스테이터스 바·네비게이션 바 색 -->
        <item name="android:statusBarColor">@color/bookshelf_yellow</item>
        <item name="android:navigationBarColor">@color/bookshelf_yellow</item>

        <!-- 앱 전체 배경 기본색 -->
        <item name="android:windowBackground">@color/bookshelf_beige</item>

        <!-- MaterialComponents 버튼 기본 스타일 오버라이드 -->
        <item name="materialButtonStyle">@style/Widget.MyBookshelf.Button</item>
    </style>

    <!-- 2) CardView 라이트 모드 전용 스타일 정의 -->
    <style name="MyCardViewLight" parent="Widget.MaterialComponents.CardView">
        <!-- 카드 모서리 둥글게 -->
        <item name="cardCornerRadius">8dp</item>
        <!-- 카드 배경색: 라이트 모드에서는 흰색(#FFFFFF)이나 pure_white 사용 -->
        <item name="cardBackgroundColor">@color/pure_white</item>
        <!-- 카드 그림자(높이) -->
        <item name="cardElevation">4dp</item>
    </style>

    <!-- 3) MaterialComponents 버튼 커스텀 스타일 정의 -->
    <style name="Widget.MyBookshelf.Button" parent="Widget.MaterialComponents.Button">
        <!-- 버튼 배경색(채우기) -->
        <item name="android:backgroundTint">@color/bookshelf_yellow</item>
        <!-- 버튼 텍스트 색 -->
        <item name="android:textColor">@android:color/white</item>
        <!-- 모서리 둥글게 -->
        <item name="cornerRadius">4dp</item>
        <!-- 여분 패딩 -->
        <item name="android:paddingVertical">12dp</item>
        <item name="android:paddingHorizontal">16dp</item>
    </style>

</resources>
